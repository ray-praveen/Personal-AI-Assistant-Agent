generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  workspaces    Workspace[]
  tasks         Task[]
  credentials   Credential[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
}

model Workspace {
  id          String   @id @default(cuid())
  userId      String
  slackTeamId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  type          TaskType
  prompt        String
  status        TaskStatus   @default(QUEUED)
  source        String       @default("dashboard")
  estimatedCost Decimal      @default(0)
  actualCost    Decimal      @default(0)
  resultJson    Json?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id])
  steps         TaskStep[]
  approvals     Approval[]
  voiceCalls    VoiceCall[]
  auditLogs     AuditLog[]
}

model TaskStep {
  id            String   @id @default(cuid())
  taskId        String
  stepNumber    Int
  action        String
  screenshotUrl String?
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id])
}

model Approval {
  id           String         @id @default(cuid())
  taskId       String
  status       ApprovalStatus @default(PENDING)
  summary      String
  screenshotUrl String?
  requestedAt  DateTime       @default(now())
  respondedAt  DateTime?
  task         Task           @relation(fields: [taskId], references: [id])
}

model VoiceCall {
  id              String   @id @default(cuid())
  taskId          String
  provider        String
  status          String
  objective       String
  phoneNumber     String?
  durationSeconds Int      @default(0)
  transcriptUrl   String?
  summary         String?
  createdAt       DateTime @default(now())
  task            Task     @relation(fields: [taskId], references: [id])
}

model Credential {
  id              String   @id @default(cuid())
  userId          String
  provider        String
  secretReference String
  status          String   @default("CONNECTED")
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  taskId    String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  task      Task?    @relation(fields: [taskId], references: [id])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String
  plan                 String
  stripeSubscriptionId String?
  status               String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id])
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum TaskType {
  WEB_AUTOMATION
  VOICE_CALL
  FORM_FILL
  PURCHASE
  RETURN
  APPOINTMENT
}

enum TaskStatus {
  DRAFT
  QUEUED
  RUNNING
  WAITING_APPROVAL
  APPROVED
  REJECTED
  COMPLETED
  FAILED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EDITED
  EXPIRED
}
